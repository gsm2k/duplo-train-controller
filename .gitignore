# Python bytecode and caches
__pycache__/
*.py[codz]

# Virtual environments and local environment settings
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and packaging output
/build/
/dist/
*.egg-info/
*.egg

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Generated documentation
/docs/_build/
/site/

# VS Code
.vscode/
*.code-workspace
tempCodeRunnerFile.py

# Local dot folders at any depth (e.g. .codex, .idea, .pytest_cache)
# Keep shared GitHub workflows and repository configuration trackable.
.*/
!/.github/
